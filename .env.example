# Local secrets for `pnpm dev`. Copy to .env (gitignored). The Cloudflare Vite
# plugin hands these to the Worker as bindings; Vite exposes only VITE_*
# variables to the browser, so nothing here reaches the client bundle. In
# production these are Worker secrets: `wrangler secret put <NAME>`.

# Signs session cookies. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin, no trailing slash. Must match the Google redirect URI
# (<origin>/api/auth/callback/google).
BETTER_AUTH_URL=http://localhost:3000

# OAuth client from console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
