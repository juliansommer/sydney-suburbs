# Neon Postgres. The Vercel Neon integration sets both in production. The
# pooled URL serves the API; migrations use the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin, no trailing slash. Must match the OAuth callback URLs
# (<origin>/api/auth/callback/google and <origin>/api/auth/callback/github).
BETTER_AUTH_URL=http://localhost:3000

# OAuth client from console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth app from github.com > Settings > Developer settings > OAuth Apps.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel Blob store for suburb photos. Only needed to run pnpm build:facts.
BLOB_READ_WRITE_TOKEN=
