    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/web": "2.0.0-rc.17",
    "base-ui-solid": "^0.3.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
