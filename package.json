{
  "name": "sydney-suburbs",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migrate; fi && vite build",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --noEmit -p server",
    "fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build:suburbs": "node --max-old-space-size=8192 scripts/build-suburbs.ts",
    "build:facts": "node --max-old-space-size=8192 scripts/build-suburb-facts.ts"
  },
